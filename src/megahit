def launch_process(*args, **kwargs):
    # A core process must retain its CPU reservation even if the launcher is
    # killed. flock releases the reservation after the last inheriting process
    # exits, without PID files, stale-process detection or a background daemon.
    if _numa_reservation is not None:
        kwargs['pass_fds'] = tuple(sorted(set(kwargs.get('pass_fds', ())) |
                                          set(_numa_reservation.fds)))
    return subprocess.Popen(*args, **kwargs)


def check_output(cmd):
    p = launch_process(cmd, stdout=subprocess.PIPE)
    out, _ = p.communicate()
    out = out.rstrip().decode('utf-8')
    assert p.wait() == 0
    return out


def abspath(path):
    return os.path.abspath(os.path.expanduser(path))


def mkdir_if_not_exists(path):
    if not os.path.exists(path):
        os.mkdir(path)


def remove_if_exists(file_name):
